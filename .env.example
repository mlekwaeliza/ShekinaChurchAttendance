# Database — use "sqlite" for local dev (zero config) or "postgres" for production
DB_CLIENT=postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Security — INITIAL_ADMIN_PASSWORD seeds the admin account (min 12 chars)
INITIAL_ADMIN_PASSWORD=ChangeMeInProduction123!
SESSION_SECRET=YourSuperSecretKeyHere_Minimum32Chars_ChangeMe
NODE_ENV=production
# Set to true only for local demos to seed 20 leader demo accounts with static passwords
# ALLOW_UNSAFE_SEED=true

# Server
PORT=3001
CLIENT_URL=http://localhost:5173
# Optional: DATABASE_URL, PGSSL=true, COOKIE_SECURE, TRUST_PROXY, SENTRY_DSN, CORS_ORIGINS, BACKUP_RETENTION_DAYS, BACKUP_REMOTE_URL
