{
  "name": "church-attendance-system",
  "version": "1.0.0",
  "description": "Church attendance tracking system with CSV upload, leader attendance marking, and pastor dashboard",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "prestart": "npm run build",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "install-all": "npm install && npm run install-client && npm run install-server",
    "install-client": "cd client && npm install",
    "install-server": "cd server && npm install",
    "build": "cd client && npm run build",
    "test": "cd server && npm test",
    "seed": "node scripts/seed-admin.js",
    "lint": "eslint . --ext .js,.jsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"{client,server,e2e,scripts,scratch,.claude,.github}/**/*.{js,jsx,json,css,md}\" \"*.{js,jsx,json,css,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"{client,server,e2e,scripts,scratch,.claude,.github}/**/*.{js,jsx,json,css,md}\" \"*.{js,jsx,json,css,md}\" --ignore-path .gitignore",
    "prepare": "node -e \"try { require.resolve('husky'); console.log('husky: running install'); require('child_process').execSync('husky install', { stdio: 'inherit' }); } catch (e) { console.log('husky: skipped (not installed)'); }\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "dompurify": "3.4.12",
    "form-data": "4.0.6",
    "lodash": "4.18.1",
    "tar": "7.5.22"
  }
}
